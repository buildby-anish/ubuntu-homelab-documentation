# ==============================================================================
# HOMELAB ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the same directory:
#      cp .env.example .env
# 2. Fill in your real values below.
# 3. NEVER commit your actual '.env' file to Git! It is ignored in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host & Localization Settings
# ------------------------------------------------------------------------------
# Set your local timezone (e.g., America/New_York, Europe/London, Asia/Kolkata, UTC)
# Find yours with: timedatectl list-timezones
TZ=UTC

# Base directory for persistent container data on your host
# Recommended standard path: /srv/docker/appdata
DOCKER_DATA_DIR=/srv/docker/appdata

# User and Group IDs for file permissions (run `id` in your terminal to see yours)
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# 2. Domain & Network
# ------------------------------------------------------------------------------
# Your public apex domain (e.g., myhomelab.net)
DOMAIN_NAME=example.com

# Notification email used for Let's Encrypt SSL certificates & alerts
ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 3. Cloudflare Tunnel (Remote Public Access)
# ------------------------------------------------------------------------------
# Obtain this token from: Cloudflare One Dashboard -> Networks -> Tunnels
# Paste only the token string here (DO NOT enclose in quotes)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# 4. Tailscale VPN (Private Remote Access)
# ------------------------------------------------------------------------------
# Optional: Tailscale Auth Key for automated container authentication
# Generate at: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. Database Credentials (Templates for your apps)
# ------------------------------------------------------------------------------
# Use strong, unique passwords for every database instance!
POSTGRES_USER=homelab_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=homelab_db

MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_SECURE_ROOT_PASSWORD
MYSQL_DATABASE=homelab_db
MYSQL_USER=homelab_user
MYSQL_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
